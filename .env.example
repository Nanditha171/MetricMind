# MetricMind Environment Configuration

# Backend API Settings
PORT=8000
HOST=0.0.0.0
ENV=development
LOG_LEVEL=INFO

# LLM / LangChain Configuration
# OpenAI, Google Gemini, or Anthropic API key
OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gpt-4o-mini
# LLM_MODEL=gemini-1.5-pro

# Database Configuration (Out-of-the-box local DuckDB / SQLite)
DATABASE_TYPE=sqlite
DATABASE_PATH=data/metricmind.db

# Snowflake Production Configuration (Optional)
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=metricmind_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=METRICMIND_DB
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ANALYTICS_ROLE

# Cube.dev Semantic Layer Integration (Optional)
CUBEJS_API_URL=http://localhost:4000/cubejs-api/v1
CUBEJS_API_SECRET=your_cube_secret_key

# Governance Guardrails
MAX_QUERY_ROWS=1000
MAX_AGENT_ITERATIONS=5
ENABLE_STRICT_METRIC_VALIDATION=true
